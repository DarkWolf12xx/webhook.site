APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost

REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=
# REDIS_PORT=
# REDIS_DB=
# Redis client library: predis (default, pure PHP) or phpredis (requires the redis extension)
# REDIS_CLIENT=predis

# You can also use a unix socket for redis (more performant)
# REDIS_CACHE_CONNECTION=unix_socket
# REDIS_UNIX_SOCKET=/var/run/redis/redis.sock

# Using Redis as cache store instead of files (default) is recommended.
# (CACHE_DRIVER, the name used by earlier releases, is still accepted.)
CACHE_STORE=redis

# Queue connection used for broadcasting and IP blocking jobs.
# (QUEUE_DRIVER, the name used by earlier releases, is still accepted.)
# QUEUE_CONNECTION=redis

# Log channel: single, daily, stderr, syslog, errorlog.
# (APP_LOG, the name used by earlier releases, is still accepted.)
# LOG_CHANNEL=stderr

# Set this for live reload functionality via Pusher
# BROADCAST_CONNECTION=pusher
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_APP_ID=
# PUSHER_CLUSTER=

# Set this for live reload functionality via Echo/Socket.io/Redis/Laravel Echo Server
# (BROADCAST_DRIVER, the name used by earlier releases, is still accepted.)
# BROADCAST_CONNECTION=redis
